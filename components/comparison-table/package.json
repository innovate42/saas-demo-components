{
  "name": "@limio/comparison-table",
  "version": "1.0.0",
  "description": "Feature comparison table across pricing tiers with checkmarks, x-marks, and text values",
  "main": "./index.js",
  "dependencies": {
    "xss": "^1.0.8"
  },
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
