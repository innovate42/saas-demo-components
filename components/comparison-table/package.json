      "id": "headline",
      "label": "Headline",
      "type": "string",
      "default": "Compare plans"
    },
    {
      "id": "tiers",
      "label": "Tier Columns",
      "type": "list",
      "fields": {
        "name": {
          "id": "name",
          "label": "Tier Name",
          "type": "string"
        },
        "price": {
          "id": "price",
          "label": "Price Label",
          "type": "string"
        },
        "ctaText": {
          "id": "ctaText",
          "label": "CTA Text",
          "type": "string"
        },
        "ctaUrl": {
          "id": "ctaUrl",
          "label": "CTA URL",
          "type": "string"
        }
      },
      "default": [
        { "name": "Lite", "price": "$99 / MONTH", "ctaText": "Select Plan", "ctaUrl": "/get-started/?sv=pricing" },
        { "name": "Essentials", "price": "$159 / MONTH", "ctaText": "Select Plan", "ctaUrl": "/get-started/?sv=pricing" },
