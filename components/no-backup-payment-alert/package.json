{
  "name": "@limio/component-no-backup-payment-alert",
  "version": "0.0.1",
  "description": "Alert banner shown when user has no backup payment method",
  "main": "./index.tsx",
  "scripts": {
    "build": "yarn component:webpack"
  },
  "author": "",
  "license": "UNLICENSED",
  "isCustomSubcomponent": true,
  "dependencies": {
    "@limio/internal-checkout-sdk": "workspace:^"
  },
  "peerDependencies": {
    "@limio/sdk": "workspace:^",
    "react": "*"
  },
  "limioProps": [
    {
      "id": "heading",
      "label": "Heading",
      "type": "string",
      "default": "No backup payment method"
    },
    {
      "id": "subline__limio_richtext",
      "label": "Description",
      "type": "richtext",
      "default": "<p>If your primary payment fails, there's no backup. Add a second method to avoid interruptions.</p>"
    },
    {
      "id": "ctaLabel",
      "label": "CTA button text",
      "type": "string",
      "default": "Add backup method"
    },
    {
      "id": "ctaUrl",
      "label": "CTA button URL",
      "type": "string",
      "default": ""
    },
    {
      "id": "backgroundColor__limio_color",
      "label": "Background color",
      "type": "color",
      "default": "#fff7ed"
    },
    {
      "id": "borderColor__limio_color",
      "label": "Border color",
      "type": "color",
      "default": "#fed7aa"
    },
    {
      "id": "textColor__limio_color",
      "label": "Text color",
      "type": "color",
      "default": "#9a3412"
    }
  ],
  "type": "module"
}
