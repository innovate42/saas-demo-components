{
  "name": "@limio/ab-contact",
  "version": "1.0.1",
  "description": "Contact page: office details (address, map link, phone, email, hours) beside a data-capture enquiry form. Brand-driven for publisher titles.",
  "main": "./index.js",
  "dependencies": {},
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "eyebrow",
      "label": "Eyebrow",
      "type": "string",
      "default": "Customer services"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "string",
      "default": "Contact us"
    },
    {
      "id": "standfirst",
      "label": "Standfirst",
      "type": "string",
      "default": "Our subscriptions team is here to help with deliveries, billing and anything else about your subscription."
    },
    {
      "id": "accentColor__limio_color",
      "label": "Accent colour",
      "type": "color",
      "default": "#2667A7"
    },
    {
      "id": "accentSoftColor__limio_color",
      "label": "Accent tint (backgrounds)",
      "type": "color",
      "default": "#E7EFF7"
    },
    {
      "id": "inkColor__limio_color",
      "label": "Ink / text colour",
      "type": "color",
      "default": "#222222"
    },
    {
      "id": "headingFont",
      "label": "Heading font stack",
      "type": "string",
      "default": "'Roboto Condensed', 'Helvetica Neue', Arial, sans-serif"
    },
    {
      "id": "bodyFont",
      "label": "Body font stack",
      "type": "string",
      "default": "'Helvetica Neue', Helvetica, Arial, sans-serif"
    },
    {
      "id": "monoFont",
      "label": "Mono / metadata font stack",
      "type": "string",
      "default": "'Roboto Mono', ui-monospace, Menlo, Consolas, monospace"
    },
    {
      "id": "officesHeading",
      "label": "Offices section heading",
      "type": "string",
      "default": "Where to find us"
    },
    {
      "id": "offices",
      "label": "Offices",
      "type": "list",
      "fields": {
        "id": { "id": "id", "label": "ID", "type": "string" },
        "name": { "id": "name", "label": "Office name", "type": "string" },
        "address": { "id": "address", "label": "Address (comma separated)", "type": "string" },
        "mapUrl": { "id": "mapUrl", "label": "Map link URL", "type": "string" },
        "mapLabel": { "id": "mapLabel", "label": "Map link label", "type": "string" },
        "phone": { "id": "phone", "label": "Phone", "type": "string" },
        "email": { "id": "email", "label": "Email", "type": "string" },
        "hours": { "id": "hours", "label": "Opening hours", "type": "string" }
      },
      "default": [
        {
          "id": "hh",
          "name": "Haywards Heath (Subscriptions)",
          "address": "Rockwood House, Perrymount Road, Haywards Heath, West Sussex, RH16 3TW, United Kingdom",
          "mapUrl": "https://www.google.com/maps/search/?api=1&query=Rockwood+House+Perrymount+Road+Haywards+Heath+RH16+3TW",
          "mapLabel": "View map and directions",
          "phone": "+44 (0)1727 890 600",
          "email": "",
          "hours": "Monday to Friday, 9am – 5pm"
        }
      ]
    },
    {
      "id": "showForm",
      "label": "Show enquiry form",
      "type": "boolean",
      "default": true
    },
    {
      "id": "formHeading",
      "label": "Form heading",
      "type": "string",
      "default": "Send us a message"
    },
    {
      "id": "formIntro",
      "label": "Form intro",
      "type": "string",
      "default": "Fill in the form and we'll come back to you within two working days."
    },
    {
      "id": "subjects",
      "label": "Enquiry subjects",
      "type": "list",
      "fields": {
        "id": { "id": "id", "label": "ID", "type": "string" },
        "label": { "id": "label", "label": "Label", "type": "string" }
      },
      "default": [
        { "id": "delivery", "label": "Delivery or missing issue" },
        { "id": "billing", "label": "Billing and payments" },
        { "id": "account", "label": "Account or address change" },
        { "id": "digital", "label": "Digital access" },
        { "id": "other", "label": "Something else" }
      ]
    },
    {
      "id": "consentText",
      "label": "Consent / opt-in text",
      "type": "string",
      "default": "Keep me posted with golf tips, subscriber offers and competitions."
    },
    {
      "id": "privacyNote",
      "label": "Privacy note",
      "type": "string",
      "default": "We use your details to answer your enquiry. See our privacy policy for how we look after your data."
    },
    {
      "id": "submitLabel",
      "label": "Submit button label",
      "type": "string",
      "default": "Send message"
    },
    {
      "id": "successHeading",
      "label": "Success heading",
      "type": "string",
      "default": "Thanks — we've got it"
    },
    {
      "id": "successBody",
      "label": "Success body",
      "type": "string",
      "default": "A member of the subscriptions team will reply to you by email within two working days."
    }
  ]
}
