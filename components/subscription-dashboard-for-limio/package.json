{
  "name": "@limio/component-subscription-dashboard",
  "version": "1.0.0",
  "description": "Enterprise subscription dashboard for Limio subscribers",
  "main": "./index.js",
  "dependencies": {},
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "welcomeHeadline",
      "label": "Welcome Headline",
      "type": "string",
      "default": "Welcome back"
    },
    {
