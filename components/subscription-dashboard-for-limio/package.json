      "label": "Dashboard Title", 
      "type": "string",
      "default": "Your Subscription Dashboard"
    },
    {
      "id": "subscriptionsHeadline",
      "label": "Subscriptions Section Title",
      "type": "string",
      "default": "Active Subscriptions"
