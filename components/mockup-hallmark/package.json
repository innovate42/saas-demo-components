{
  "name": "component-mockup-hallmark",
  "version": "1.0.0",
  "description": "Full-page replica of the Hallmark Health Care Solutions homepage",
  "main": "./index.tsx",
  "type": "module",
  "sideEffects": ["*.css"],
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "showAnnouncementBar",
