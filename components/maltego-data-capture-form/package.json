{
  "name": "@limio/maltego-data-capture-form",
  "version": "1.0.0",
  "description": "Maltego Data Capture Form - collects customer information and sends to Salesforce via platform event, with optional redirect on success",
  "main": "./index.js",
  "scripts": {
    "build": "yarn component:webpack",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@limio/component-library": "workspace:^",
    "@limio/shop": "workspace:^"
  },
  "peerDependencies": {
    "@limio/sdk": "*",
    "@limio/ui-form": "*",
    "react": "*"
  },
  "limioProps": [
    {
      "id": "subcomponentMetadata",
      "type": "subcomponentMetadata",
      "label": "Subcomponent Metadata",
      "default": []
    },
    {
      "id": "requiredLabel",
      "label": "Required field label",
      "type": "string",
      "default": "Required"
    },
    {
      "id": "optionalLabel",
      "label": "Optional field label",
      "type": "string",
      "default": ""
    },
    {
      "id": "submitLabel",
      "type": "string",
      "label": "Submit button label",
      "default": "Submit"
    },
    {
      "id": "successFormMessage",
      "label": "Success form message",
      "type": "richtext",
      "default": "Thank you for submitting your information."
    },
    {
      "id": "successFormMessageFontColor",
      "label": "Success form message font color",
      "type": "color",
      "default": "#155724"
    },
    {
      "id": "successFormMessageBackgroundColor",
      "label": "Success message background color",
      "type": "color",
      "default": "#d4edda"
    },
    {
      "id": "invalidFormMessage",
      "label": "Invalid form message",
      "type": "richtext",
      "default": "We are sorry, but there was an error processing your order. Please try again later."
    },
    {
      "id": "invalidFormMessageFontColor",
      "label": "Invalid form message font color",
      "type": "color",
      "default": "#856404"
    },
    {
      "id": "invalidFormMessageBackgroundColor",
      "label": "Invalid message background color",
      "type": "color",
      "default": "#fff3cd"
    },
    {
      "id": "redirectUrl",
      "label": "Redirect URL",
      "type": "string",
      "default": ""
    }
  ],
  "limioSubcomponents": [
    "/limio-components/field",
    "/limio-components/display-text"
  ],
  "limioCapabilities": [
    "googleCaptcha"
  ]
}
