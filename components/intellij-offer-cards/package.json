{
  "name": "@limio/intellij-offer-cards",
  "version": "1.0.0",
  "description": "Offer cards styled like IntelliJ IDEA with dark theme and JetBrains aesthetic",
  "main": "./index.js",
  "dependencies": {
    "xss": "^1.0.14",
    "ramda": "^0.29.1"
  },
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "headline",
      "label": "Headline",
      "type": "string",
      "default": "Choose Your Plan"
    },
    {
      "id": "subheadline",
      "label": "Subheadline",
      "type": "string",
      "default": "All plans include access to core features and updates"
    },
    {
      "id": "accentColor",
      "label": "Accent Color",
      "type": "color",
      "default": "#087CFA"
    },
    {
      "id": "showGroupToggle",
      "label": "Show Group Toggle",
      "type": "boolean",
      "default": true
    },
    {
      "id": "groupLabels",
      "label": "Group Labels",
      "type": "list",
      "fields": {
        "id": { "id": "id", "label": "ID", "type": "string" },
        "label": { "id": "label", "label": "Label", "type": "string" }
      },
      "default": [
        { "id": "monthly", "label": "Monthly" },
        { "id": "annual", "label": "Annual" }
      ]
    },
    {
      "id": "ctaText",
      "label": "CTA Button Text",
      "type": "string",
      "default": "Get Started"
    },
    {
      "id": "showFeatures",
      "label": "Show Features List",
      "type": "boolean",
      "default": true
    }
  ]
}
