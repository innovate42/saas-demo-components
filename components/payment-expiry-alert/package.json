{
  "name": "@limio/component-payment-expiry-alert",
  "version": "0.0.2",
  "description": "Alert banner shown when the default payment method is expiring soon or has expired",
  "main": "./index.tsx",
  "scripts": {
    "build": "yarn component:webpack"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@limio/internal-checkout-sdk": "workspace:^"
  },
  "peerDependencies": {
    "@limio/sdk": "workspace:^",
    "react": "*"
  },
  "limioProps": [
    {
      "id": "heading",
      "label": "Expiring soon heading",
      "type": "string",
      "default": "Your payment method is expiring soon"
    },
    {
      "id": "subline__limio_richtext",
      "label": "Expiring soon description",
      "type": "richtext",
      "default": "<p>Your {{brand}} ending in {{last4}} expires in {{daysUntilExpiry}} days. Update your payment method to avoid interruptions.</p>"
    },
    {
      "id": "expiredHeading",
      "label": "Expired heading",
      "type": "string",
      "default": "Your payment method has expired"
    },
    {
      "id": "expiredSubline__limio_richtext",
      "label": "Expired description",
      "type": "richtext",
      "default": "<p>Your {{brand}} ending in {{last4}} has expired. Update your payment method to avoid service interruptions.</p>"
    },
    {
      "id": "ctaLabel",
      "label": "CTA button text",
      "type": "string",
      "default": "Update payment method"
    },
    {
      "id": "ctaUrl",
      "label": "CTA button URL",
      "type": "string",
      "default": "/add-payment-method"
    },
    {
      "id": "expiryThresholdDays",
      "label": "Expiry threshold (days)",
      "type": "string",
      "default": "90"
    },
    {
      "id": "showWhenBackupExists",
      "label": "Show when backup payment exists",
      "type": "picklist",
      "options": [
        { "id": "true", "label": "Yes - always show", "value": "true" },
        { "id": "false", "label": "No - hide if backup exists", "value": "false" }
      ],
      "default": "true"
    },
    {
      "id": "backgroundColor__limio_color",
      "label": "Background color",
      "type": "color",
      "default": "#fff7ed"
    },
    {
      "id": "borderColor__limio_color",
      "label": "Border color",
      "type": "color",
      "default": "#fed7aa"
    },
    {
      "id": "textColor__limio_color",
      "label": "Text color",
      "type": "color",
      "default": "#9a3412"
    }
  ],
  "type": "module"
}
