{
  "name": "@limio/ab-cancel",
  "version": "1.0.0",
  "description": "Cancellation reason capture that routes each reason to the right outcome \u2014 save offer, downgrade or cancel.",
  "main": "./index.js",
  "dependencies": {},
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "offerLabel",
      "label": "Offer label for this title",
      "type": "string",
      "default": "todaysgolfer"
    },
    {
      "id": "eyebrow",
      "label": "Eyebrow",
      "type": "string",
      "default": "Before you go"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "string",
      "default": "Tell us what's not working"
    },
    {
      "id": "subheading",
      "label": "Sub-heading",
      "type": "string",
      "default": "Whatever the reason, there's usually something we can do about it. Pick the closest one and we'll take it from there."
    },
    {
      "id": "continueLabel",
      "label": "Continue button",
      "type": "string",
      "default": "Continue"
    },
    {
      "id": "backLabel",
      "label": "Back link",
      "type": "string",
      "default": "Keep my subscription"
