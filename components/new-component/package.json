    {
      "id": "primaryColor__limio_color",
      "label": "Primary Color",
      "type": "color",
      "default": "#0080ff"
    },
    {
      "id": "showAlternativeCta",
      "label": "Show Alternative CTA",
      "type": "boolean",
      "default": true
    },
    {
      "id": "alternativeCtaText",
      "label": "Alternative CTA Text",
      "type": "string",
      "default": "Explore Other Plans"
    }
