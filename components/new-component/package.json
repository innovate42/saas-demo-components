{
  "name": "@limio/component-new-component",
  "version": "1.0.1",
  "description": "Shows features you will lose if you cancel subscription",
  "main": "./index.js",
  "dependencies": {},
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "headline",
      "label": "Headline",
      "type": "string",
      "default": "What you'll lose if you cancel"
    },
    {
      "id": "subheadline",
      "label": "Subheadline",
      "type": "string",
      "default": "Keep these essential features by staying subscribed"
    },
    {
