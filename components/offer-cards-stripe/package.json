{
  "name": "@user/offer-cards-stripe",
  "version": "1.0.0",
  "description": "Stripe-styled offer cards with animated background for Limio",
  "main": "index.js",
  "limioProps": [
    {
      "id": "heading",
      "type": "string",
      "label": "Heading",
      "default": "Simple, transparent pricing"
    },
    {
      "id": "subheading",
      "type": "string",
      "label": "Subheading",
      "default": "Choose the plan that's right for you. All plans include a 14-day free trial."
    },
    {
      "id": "componentId",
      "type": "string",
      "label": "Component Id",
      "default": "offers-stripe"
    },
    {
      "id": "themeColor",
      "type": "picklist",
      "label": "Theme Color",
      "options": [
        { "id": "purple", "label": "Stripe Purple", "value": "purple" },
        { "id": "blue", "label": "Stripe Blue", "value": "blue" },
        { "id": "indigo", "label": "Indigo", "value": "indigo" },
        { "id": "emerald", "label": "Emerald", "value": "emerald" },
        { "id": "slate", "label": "Slate", "value": "slate" }
      ],
      "default": "purple"
    },
    {
      "id": "backgroundStyle",
      "type": "picklist",
      "label": "Background Style",
      "options": [
        { "id": "animated", "label": "Animated Gradient", "value": "animated" },
        { "id": "minimal", "label": "Minimal", "value": "minimal" },
        { "id": "dark", "label": "Dark Mode", "value": "dark" }
      ],
      "default": "animated"
    },
    {
      "id": "groupLabels",
      "label": "Group Labels",
      "type": "list",
      "fields": {
        "name": {
          "id": "id",
          "label": "ID",
          "type": "string"
        },
        "url": {
          "id": "label",
          "label": "URL",
          "type": "string"
        },
        "thumbnail": {
          "id": "thumbnail",
          "label": "Thumbnail",
          "type": "string",
          "format": "uri",
          "purpose": "image"
        }
      },
      "default": [
        {
          "id": "monthly",
          "label": "Monthly"
        },
        {
          "id": "annual",
          "label": "Annual"
        }
      ]
    },
    {
      "id": "showGroupedOffers",
      "type": "boolean",
      "label": "Show Billing Toggle",
      "default": true
    },
    {
      "id": "annualSavingsLabel",
      "type": "string",
      "label": "Annual Savings Label",
      "default": "Save 20%"
    },
    {
      "id": "showFeatureComparison",
      "type": "boolean",
      "label": "Show Feature Checkmarks",
      "default": true
    }
  ],
  "dependencies": {
    "ramda": "^0.28.0",
    "xss": "^1.0.8"
  }
}
