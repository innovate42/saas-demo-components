{
  "name": "@limio/cebroker-offer-cards",
  "version": "1.0.0",
  "description": "Stacked offer cards with left-side group filter (CeBroker-style search results layout).",
  "main": "./index.js",
  "scripts": {
    "build": "yarn component:webpack",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "xss": "^1.0.8"
  },
  "peerDependencies": {
    "react": "*"
  },
  "limioProps": [
    {
      "id": "heading",
      "label": "Heading",
      "type": "string",
      "default": "Propelus Plans and Packages"
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "string",
      "default": "Find the best course or subscription for you"
    },
    {
      "id": "filterLabel",
      "label": "Sidebar filter title",
      "type": "string",
      "default": "Filter by"
    },
    {
      "id": "componentId",
      "label": "Component Id",
      "type": "string",
      "default": "cebroker-offer-cards"
    },
    {
      "id": "primaryColor",
      "label": "Primary color",
      "type": "string",
      "default": "#0B5394"
    },
    {
      "id": "showImage",
      "label": "Show offer image",
      "type": "boolean",
      "default": true
    },
    {
      "id": "showRoleFilter",
      "label": "Show role filter",
      "type": "boolean",
      "default": true
    },
    {
      "id": "roleFilterLabel",
      "label": "Role filter label",
      "type": "string",
      "default": "I'm a"
    },
    {
      "id": "roleFilterAllLabel",
      "label": "Role filter 'all' option label",
      "type": "string",
      "default": "All roles"
    },
    {
      "id": "roleLabels",
      "label": "Role options",
      "type": "list",
      "fields": {
        "name": {
          "id": "id",
          "label": "ID",
          "type": "string"
        },
        "url": {
          "id": "label",
          "label": "Label",
          "type": "string"
        }
      },
      "default": [
        {
          "id": "nurse-midwife",
          "label": "Nurse Midwife"
        },
        {
          "id": "pharmacist",
          "label": "Pharmacist"
        },
        {
          "id": "physician",
          "label": "Physician"
        }
      ]
    },
    {
      "id": "groupLabels",
      "label": "Group options",
      "type": "list",
      "fields": {
        "name": {
          "id": "id",
          "label": "ID",
          "type": "string"
        },
        "url": {
          "id": "label",
          "label": "Label",
          "type": "string"
        }
      },
      "default": [
        {
          "id": "one-time",
          "label": "One Time Courses"
        },
        {
          "id": "subscription",
          "label": "Subscriptions"
        }
      ]
    },
    {
      "id": "showGroupedOffers",
      "label": "Enable sidebar group filter",
      "type": "boolean",
      "default": true
    },
    {
      "id": "showKeywordSearch",
      "label": "Show keyword search",
      "type": "boolean",
      "default": true
    },
    {
      "id": "showFreeTrialLink",
      "label": "Show free trial link",
      "type": "boolean",
      "default": true
    },
    {
      "id": "freeTrialLink",
      "label": "Free trial link",
      "type": "richText",
      "default": "Start a free trial"
    }
  ]
}
