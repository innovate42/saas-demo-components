  "limioProps": [
    {
      "id": "heading",
      "label": "Heading",
      "type": "string",
      "default": "Click, subscribe, start hiring."
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "string",
      "default": "Join today for instant access to JazzHR."
    },
    {
      "id": "componentId",
      "label": "Component ID",
      "type": "string",
      "default": "pricing-cards-tiered"
    },
    {
      "id": "showFeatures",
      "label": "Show Features",
      "type": "boolean",
      "default": true
    },
    {
