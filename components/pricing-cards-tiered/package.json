      "type": "list",
      "fields": {
        "id": {
          "id": "id",
          "label": "Billing ID",
          "type": "string"
        },
        "label": {
          "id": "label",
          "label": "Button Label",
          "type": "string"
        },
        "description": {
          "id": "description",
          "label": "Description",
          "type": "string"
        }
      },
      "default": [
        { "id": "annual-monthly", "label": "Pay Monthly", "description": "Annual commitment, billed monthly" },
        { "id": "annual-upfront", "label": "Pay Upfront", "description": "Annual commitment, save more" }
      ]
    },
    {
      "id": "topLevelLabels",
      "label": "Top Level Tabs",
      "type": "list",
      "fields": {
        "id": {
          "id": "id",
          "label": "Tab ID",
          "type": "string"
        },
        "label": {
          "id": "label",
          "label": "Tab Label",
          "type": "string"
        }
      },
      "default": [
        { "id": "monthly", "label": "Monthly Plans" },
        { "id": "annual", "label": "1 Year Plans" }
      ]
