      "default": "annual-monthly"
    },
    {
      "id": "themeColor",
      "label": "Theme Color",
      "type": "picklist",
      "options": [
        { "id": "jazzHR", "label": "JazzHR", "value": "jazzHR" }
      ],
      "default": "jazzHR"
    },
    {
      "id": "tierOrder",
      "label": "Tier Order",
      "type": "list",
      "fields": {
        "id": {
          "id": "id",
          "label": "Tier ID",
          "type": "string"
        },
        "label": {
          "id": "label",
          "label": "Display Label",
          "type": "string"
        }
      },
      "default": [
        { "id": "hero", "label": "Hero" },
        { "id": "plus", "label": "Plus" },
        { "id": "pro", "label": "Pro" }
      ]
    },
    {
      "id": "billingLabels",
