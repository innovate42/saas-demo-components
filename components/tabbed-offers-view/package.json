{
  "name": "@limio/my-component",
  "version": "1.0.0",
  "description": "Tabbed offer cards component with detailed hero display",
  "main": "./index.js",
  "dependencies": {},
  "peerDependencies": { "react": "*" },
  "limioProps": [
    {
      "id": "headline",
      "label": "Headline",
      "type": "string",
      "default": "Choose Your Plan"
    },
    {
      "id": "description__limio_richtext",
      "label": "Description",
      "type": "richText",
      "default": "<p>Select a plan that works best for you</p>"
    },
    {
      "id": "primaryColor__limio_color",
      "label": "Primary Color",
      "type": "color",
      "default": "#FF6B35"
    },
    {
      "id": "accentColor__limio_color",
      "label": "Accent Color",
      "type": "color",
      "default": "#6366F1"
    },
    {
      "id": "groupLabels",
      "label": "Group Labels",
      "type": "list",
      "fields": {
        "id": {
          "id": "id",
          "label": "ID",
          "type": "string"
        },
        "label": {
          "id": "label",
          "label": "Label",
          "type": "string"
        }
      },
      "default": [
        { "id": "monthly", "label": "Monthly" },
        { "id": "yearly", "label": "Annual" }
      ]
    },
    {
      "id": "showBilling",
      "label": "Show Billing Toggle",
      "type": "boolean",
      "default": true
    },
    {
      "id": "featuresTitle",
      "label": "Features Section Title",
      "type": "string",
      "default": "What's Included"
    },
    {
      "id": "detailsTitle",
      "label": "Details Section Title",
      "type": "string",
      "default": "Plan Details"
    },
    {
      "id": "theme",
      "label": "Theme",
      "type": "picklist",
      "options": [
        { "id": "light", "label": "Light", "value": "light" },
        { "id": "dark", "label": "Dark", "value": "dark" }
      ],
      "default": "light"
    }
  ]
}